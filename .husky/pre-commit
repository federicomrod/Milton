echo "🔍 Running pre-commit checks..."

echo "💅 Formatting staged files..."
# Get list of staged files that Prettier can format
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|css|md|yml|yaml|mjs)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Format only the staged files
  echo "$STAGED_FILES" | xargs npx prettier --write 2>/dev/null || true
  
  # Re-stage only the files that were already staged
  # This ensures we don't accidentally stage files you didn't intend to commit
  for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
      git add "$file" 2>/dev/null || true
    fi
  done
  echo "✅ Formatted and re-staged $(echo "$STAGED_FILES" | wc -l | tr -d ' ') file(s)"
fi

echo "🔎 Running type check..."
npm run type-check || {
  echo "❌ Type checking failed. Please fix the errors before committing."
  exit 1
}

echo "📝 Running linter (warnings are ignored)..."
# Only lint staged files - warnings are allowed, only errors will block  
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$STAGED_TS_FILES" ]; then
  # Run eslint and check output - allow warnings, block on errors
  LINT_OUTPUT=$(echo "$STAGED_TS_FILES" | xargs npx eslint --max-warnings=999999 2>&1)
  # Check if output shows any errors (not just warnings)
  # ESLint output format: "✖ X problems (Y errors, Z warnings)"
  if echo "$LINT_OUTPUT" | grep -qE "\([1-9][0-9]* error"; then
    echo "$LINT_OUTPUT"
    echo "❌ Linting found ERRORS. Please fix them or use --no-verify to skip."
    exit 1
  else
    # Only warnings (0 errors) or no issues
    echo "✅ Linting completed (warnings are ignored)"
  fi
else
  echo "ℹ️  No TypeScript/JavaScript files staged. Skipping lint check."
fi

echo "✅ Pre-commit checks completed!"
